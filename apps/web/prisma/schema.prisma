generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
}

model Event {
  id               String   @id @default(cuid())
  source           String   @default("manual")
  breezeInstanceId String?  @unique
  breezeEventId    String?
  breezeCategoryId String?
  syncStatus       String   @default("manual")
  lastSyncedAt     DateTime?

  title            String
  startAt          DateTime
  endAt            DateTime?
  allDay           Boolean  @default(false)
  shortDescription String?
  fullDescription  String?
  location         String?
  imageUrl         String?
  registrationUrl  String?
  urlLabel         String   @default("register")
  breezeDescription String?

  featured         Boolean  @default(false)
  sortOrder        Int      @default(0)
  kioskVisible     Boolean  @default(true)
  status           String   @default("draft")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, kioskVisible, startAt])
  @@index([source])
}

model Settings {
  id                  String   @id @default("default")
  orgName             String   @default("Our Organization")
  orgLogoUrl          String?
  kioskShowLogo       Boolean  @default(true)
  kioskShowOrgName    Boolean  @default(true)
  brandPrimaryColor   String   @default("#2563eb")
  brandSecondaryColor String   @default("#0f172a")
  kioskBackgroundColor String  @default("#f1f5f9")
  kioskTextColor      String   @default("#0f172a")
  kioskMutedTextColor String   @default("#64748b")
  kioskPrimaryFont    String   @default("Playfair Display")
  kioskSecondaryFont  String   @default("DM Sans")
  breezeSubdomain     String?
  breezeApiKey        String?
  breezeCalendarIds   String   @default("[]")
  lastBreezeSyncAt    DateTime?
  lastBreezeSyncError String?
  kioskRefreshAt          DateTime?
  settingsUpdatedAt       DateTime?
  kioskIdleTimeoutSeconds Int      @default(60)
  kioskBackgroundAnimated Boolean  @default(true)
  kioskBackgroundStyle    String   @default("gradient")
  kioskBackgroundImageUrl String?
  registrationDomainEnforcement Boolean @default(true)

  newsletterEnabled     Boolean @default(true)
  newsletterTitle       String  @default("Newsletter")
  newsletterBody        String  @default("Stay connected. Sign up for our newsletter.")
  newsletterUrl         String  @default("")
  newsletterButtonLabel String  @default("Sign up")

  givingEnabled              Boolean @default(true)
  givingTitle                String  @default("Give")
  givingBody                 String  @default("Share your contact information and we will follow up with ways to give.")
  givingSuccessMessage       String  @default("Thank you. We will follow up with giving information.")
  givingNotifyEmail          String  @default("")
  givingVisitorEmailSubject  String  @default("How to give")
  givingVisitorEmailBody     String  @default("Thank you for your interest in giving. We will follow up with information about how to give.")

  kioskDisplayEnabled         Boolean @default(true)
  kioskDisplayScheduleEnabled Boolean @default(false)
  kioskDisplayOnDays          String  @default("[0]")
  kioskDisplayOnTime          String  @default("07:00")
  kioskDisplayOffTime         String  @default("22:00")
  kioskDisplayIdleOffSeconds  Int     @default(0)

  updatedAt              DateTime @updatedAt
}

model AllowedDomain {
  id     String @id @default(cuid())
  domain String @unique
}

model Inquiry {
  id          String   @id @default(cuid())
  kind        String   @default("giving")
  name        String
  email       String
  phone       String?
  message     String?
  emailStatus String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, createdAt])
  @@index([emailStatus])
}
